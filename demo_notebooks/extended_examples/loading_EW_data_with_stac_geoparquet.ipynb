    "for i, t in enumerate(ds.time.values):\n",
    "    time_slice = ds.sel(time=t)\n",
    "    timestamp = str(t)[:19].replace(\":\", \"-\").replace(\" \", \"T\")\n",
    "    \n",
    "    for asset in assets_to_download:\n",
    "        out_path = download_folder / f\"{asset}_{timestamp}.tif\"\n",
    "        \n",
    "        # Skip if file already exists AND is non‑empty\n",
    "        if out_path.exists() and out_path.stat().st_size > 0:\n",
    "            print(f\"Skipping existing file: {out_path}\")\n",
    "            continue\n",
    "        \n",
    "        # Write the file\n",
    "        time_slice[asset].rio.to_raster(out_path)\n",
    "        print(f\"Saved ({i+1} of {len(ds.time.values)}): {out_path}\")"
   ]
